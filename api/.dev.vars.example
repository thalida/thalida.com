# Copy this file to .dev.vars and fill in the values.
# .dev.vars is gitignored and used by Wrangler for local development.

# Password used to authenticate as the site owner (thalida).
# Pick any string. Log in via the "admin login" button in the chat panel.
ADMIN_PASSWORD=

# Secret key used for HMAC signing (session tokens, client identity tokens).
# Pick any random string — must be different from ADMIN_PASSWORD.
SIGNING_SECRET=

# OpenAI API key for chat content moderation (free Moderation API).
# Get one at https://platform.openai.com/api-keys
# Leave blank to disable moderation locally (all messages will pass through).
OPENAI_API_KEY=

# IP Registry API key for geolocation (used by /location endpoint).
# Get one at https://ipregistry.co/
IPREGISTRY_KEY=

# OpenWeather API key for weather data (used by /weather endpoint).
# Get one at https://openweathermap.org/api
OPENWEATHER_KEY=
