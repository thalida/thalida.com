---
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import { Image } from "astro:assets";
import meMemoji from "@assets/about/me-memoji.png";
import meHeadshot from "@assets/about/me-headshot.png";
import meAvatar from "@assets/about/me-avatar.png";
import meRainbow from "@assets/about/me-rainbow.png";
---

<BaseLayout
  title="about · thalida"
  activePage="about"
  pageContext={{ collection: "page", id: "about", title: "About" }}
>
  <article class="about-page">
    <h2>About</h2>
    <hr />

    <div class="about-photos">
      <Image src={meMemoji} alt="A Memoji of Thalida" class="about-photo" />
      <Image src={meHeadshot} alt="A headshot of Thalida" class="about-photo" />
      <Image src={meAvatar} alt="A cartoon avatar of Thalida" class="about-photo" />
      <Image src={meRainbow} alt="A rainbow themed image of Thalida" class="about-photo" />
    </div>

    <h3>Hey, I'm Thalida!</h3>
    <p>I'm a queer (pronouns they/she) first generation Trinidadian-American Engineer based in New York.</p>
    <p>
      Over 14 years ago for my 16th birthday I wanted one thing: a domain of my own. I was lucky enough to have a
      supportive mother who gifted me thalida.com, and over the years this site has been the place where I learn, grow,
      and experiment.
    </p>
    <p>
      I use this space to practice and learn, break things and experiment, grow and challenge myself in ways that have
      fewer consequences than messing around on a domain someone else owns. Here I am able to push myself as an
      engineer, designer, and writer. Which is all to say: if it's ever broken, janky, or weird, I'm probably in the
      process of learning something new, and you're coming along for the ride with me! ✨
    </p>
    <p>If you're interested in connecting:</p>
    <ul>
      <li><a href="https://linkedin.com/in/thalida/" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://github.com/thalida" target="_blank" rel="noopener">Github</a></li>
      <li><a href="mailto:hello@thalida.com">Email</a></li>
    </ul>

    <hr />

    <h3>Career History</h3>
    <p>
      I have over 10 years of experience in the tech industry, working in various roles from Product Engineering to
      Engineering Management. My journey has taken me through startups, large corporations, and everything in between.
    </p>
    <ul>
      <li>Currently, I'm an Engineering Manager at Zapier on the MCP Team!</li>
      <li>
        Previously, I was Co-Founder and CTO of <a href="https://tourus.io">Tourus</a>, a VC-backed mobile-first AI,
        automation, and communication suite for property managers and leasing agents
      </li>
      <li>
        Back in the day, I've worked at <a href="https://webflow.com/">Webflow</a>, <a href="https://www.etsy.com"
          >Etsy</a
        >, and <a href="https://www.okcupid.com/">OkCupid</a> as a Lead Engineer and Senior Engineering Manager
      </li>
      <li>I also have experience in design and product management</li>
    </ul>

    <hr />

    <h3>About this site</h3>
    <p>
      This site is built with <a href="https://astro.build">Astro</a> and hosted on <a
        href="https://pages.cloudflare.com">Cloudflare Pages</a
      >.
    </p>
  </article>
</BaseLayout>

<style>
  @reference "../layouts/BaseLayout/BaseLayout.css";

  .about-page {
    @apply font-body max-w-3xl;
  }

  .about-page h2 {
    @apply m-0 mb-2 font-display font-bold text-neon text-display-sm tracking-display leading-none;
  }

  .about-page h3 {
    @apply font-heading text-xl font-semibold text-teal mt-6 mb-2 tracking-heading;
  }

  .about-page p {
    @apply text-text mb-4 leading-relaxed;
  }

  .about-page ul {
    @apply text-text mb-4 pl-4 list-disc;
  }

  .about-page li {
    @apply mb-2 leading-relaxed;
  }

  .about-page a {
    @apply text-teal hover:text-neon;
  }

  .about-photo {
    @apply w-full h-auto border border-border rounded-lg;
  }

  .about-photos {
    @apply grid grid-cols-4 gap-2 mb-6;
  }

  @media (max-width: 767px) {
    .about-photos {
      @apply grid-cols-2;
    }
  }
</style>
