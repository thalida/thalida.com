---
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { COLLECTION_NAMES, type CollectionName } from "../../content.config";

type AnyEntry = CollectionEntry<CollectionName>;

export async function getStaticPaths() {
  const routable = new Set(["projects", "guides", "gallery", "recipes", "versions"]);
  const paths: Array<{
    params: { collection: string; id: string };
    props: { entry: AnyEntry };
  }> = [];

  for (const name of COLLECTION_NAMES) {
    if (!routable.has(name)) continue;

    const entries = await getCollection(name, ({ data }) => !data.draft);
    for (const entry of entries) {
      paths.push({
        params: { collection: name, id: entry.id },
        props: { entry },
      });
    }
  }

  return paths;
}

const { collection, id } = Astro.params;
const { entry } = Astro.props;

let Content: AstroComponentFactory | null = null;
try {
  const rendered = await render(entry);
  Content = rendered.Content;
} catch {
  // Content could not be rendered
}

const pageTitle = entry.data.title as string;
---

<BaseLayout
  title={`${pageTitle} · thalida`}
  activeCollection={collection}
  pageContext={{ collection: collection!, id: id!, title: pageTitle }}
>
  <article class="post-page">
    <header class="post-header">
      <p class="post-breadcrumb">
        <a href={`/${collection}`}>{collection}</a>
        {
          entry.data.category && (
            <span>
              {" "}
              / <a href={`/${collection}/${entry.data.category}`}>{entry.data.category}</a>
            </span>
          )
        }
      </p>
      <h1>{pageTitle}</h1>
      {entry.data.description && <p class="post-description">{entry.data.description}</p>}
      <div class="post-meta">
        {
          entry.data.publishedOn && (
            <time class="post-date">
              {new Date(entry.data.publishedOn).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          )
        }
      </div>
    </header>
    <hr />
    <div class="post-content prose prose-invert prose-sm max-w-none">
      {Content ? <Content /> : <p>Content could not be rendered.</p>}
    </div>
  </article>
</BaseLayout>

<style>
  @reference "../../layouts/BaseLayout/BaseLayout.css";

  .post-page {
    @apply font-body max-w-3xl mx-auto;
  }

  .post-breadcrumb {
    @apply m-0 mb-3 font-body uppercase text-neon font-semibold text-2xs tracking-widest;
  }

  .post-breadcrumb a {
    @apply text-neon no-underline;
  }

  .post-breadcrumb a:hover {
    @apply text-teal;
  }

  .post-header {
    @apply mb-6;
  }

  .post-header h1 {
    @apply m-0 mb-3 font-display font-bold text-neon text-display tracking-tighter leading-display;
  }

  .post-description {
    @apply m-0 mb-3 font-heading font-semibold text-teal text-subtitle tracking-tight;
  }

  .post-meta {
    @apply flex flex-wrap items-center gap-3;
  }

  .post-date {
    @apply text-sm text-muted;
  }

  .post-content {
    @apply text-text font-body;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    @apply font-heading text-text;
  }

  .post-content :global(h2) {
    @apply text-teal;
  }

  .post-content :global(pre) {
    @apply bg-surface border border-border;
  }

  .post-content :global(pre) :global(code) {
    @apply border-none bg-transparent p-0;
  }

  .post-content :global(code) {
    @apply font-body bg-surface border border-border;
  }

  .post-content :global(a) {
    @apply text-teal hover:text-neon;
  }

  .post-content :global(img) {
    @apply rounded-lg;
  }
</style>
