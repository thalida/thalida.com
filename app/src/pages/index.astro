---
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import { getNavData } from "@lib/nav-data";

const openweatherKey = import.meta.env.PUBLIC_OPENWEATHER_KEY || "";
const ipregistryKey = import.meta.env.PUBLIC_IPREGISTRY_KEY || "";

const navData = await getNavData();

// Featured projects: 3 most recent with cover images
const featuredProjects = navData.projects.items.filter((p) => p.coverImageSrc).slice(0, 3);

// Timeline: all versions sorted chronologically (oldest first)
const versions = [...navData.versions.items].reverse();
const latestYear = versions.at(-1)?.category || "";
const siteAge = new Date().getFullYear() - 2007;
---

<BaseLayout activePage="">
  {/* ── Hero ── */}
  <section class="flex flex-col items-center text-center gap-8" aria-label="Introduction">
    <live-window openweather-key={openweatherKey} ipregistry-key={ipregistryKey} theme="dark"></live-window>
    <div class="max-w-lg">
      <h1 class="m-0 font-display font-bold text-neon text-display-lg tracking-tighter leading-none">
        <span id="js-greeting">Hey</span>, I'm&nbsp;Thalida.
      </h1>
      <p class="m-0 mt-4 font-heading text-muted leading-relaxed text-subtitle tracking-tight">
        Making weird and wonderful things on the internet since 2007.
      </p>
    </div>
  </section>

  {/* ── Featured Projects ── */}
  <section class="mt-16" aria-label="Selected work">
    <div class="flex items-center gap-3 mb-6">
      <span class="font-body text-2xs text-muted uppercase tracking-widest whitespace-nowrap">SELECTED WORK</span>
      <hr class="grow border-t border-border my-0" />
      <a
        href="/projects"
        class="font-body text-xs text-teal no-underline whitespace-nowrap tracking-wider inline-flex items-center gap-1 hover:text-neon"
        >view all <svg class="inline-block" style="width:0.55em;height:0.55em" viewBox="0 0 320 512" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
          ></path></svg
        ></a
      >
    </div>
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="block no-underline bg-surface border border-border rounded-lg overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover"
          >
            <img
              class="w-full object-cover"
              style="aspect-ratio:16/10"
              src={project.coverImageSrc}
              alt={project.coverImageAlt ?? project.title}
              loading="lazy"
            />
            <div class="p-4">
              {project.category && (
                <span class="font-body text-2xs text-muted uppercase tracking-widest">{project.category}</span>
              )}
              <h3 class="m-0 mt-1 font-heading text-text text-sm font-medium">{project.title}</h3>
              {project.description && (
                <p class="m-0 mt-2 font-body text-muted text-xs leading-relaxed line-clamp-2">{project.description}</p>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {/* ── Site Timeline ── */}
  <section class="mt-16" aria-label="Site timeline">
    <div class="flex items-center gap-3 mb-6">
      <span class="font-body text-2xs text-muted uppercase tracking-widest whitespace-nowrap"
        >{siteAge} YEARS OF THALIDA.COM</span
      >
      <hr class="grow border-t border-border my-0" />
      <a
        href="/versions"
        class="font-body text-xs text-teal no-underline whitespace-nowrap tracking-wider inline-flex items-center gap-1 hover:text-neon"
        >view all <svg class="inline-block" style="width:0.55em;height:0.55em" viewBox="0 0 320 512" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
          ></path></svg
        ></a
      >
    </div>
    <div class="home-timeline relative overflow-x-auto" role="region" aria-label="Site version timeline" tabindex="0">
      <div class="home-timeline__track flex gap-6 pb-4 relative" style="min-width:max-content">
        {
          versions.map((version) => {
            const year = version.category || "";
            const name = version.title.replace(/^\d{4}:\s*/, "");
            const isCurrent = year === latestYear;
            return (
              <a
                href={`/versions/${version.id}`}
                class:list={[
                  "group flex flex-col items-center no-underline relative",
                  { "home-timeline__item--current": isCurrent },
                ]}
                style="flex:0 0 auto;width:90px"
              >
                <div class="home-timeline__thumb w-20 h-14 rounded overflow-hidden bg-surface border border-border relative z-10 group-hover:border-teal">
                  {version.coverImageSrc ? (
                    <img
                      class="w-full h-full object-cover"
                      src={version.coverImageSrc}
                      alt={version.coverImageAlt ?? version.title}
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-surface" />
                  )}
                </div>
                <span class="font-body text-2xs text-text mt-2 font-medium group-hover:text-teal">{year}</span>
                <span class="home-timeline__name font-body text-muted mt-0.5 text-center leading-tight">{name}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/live-window/live-window.ts"></script>

<script>
  function updateGreeting() {
    const hour = new Date().getHours();
    let greeting;
    if (hour < 3) greeting = "Hey Night Owl";
    else if (hour < 7) greeting = "Hey Early Bird";
    else if (hour < 12) greeting = "Good Morning";
    else if (hour < 17) greeting = "Good Afternoon";
    else if (hour < 21) greeting = "Good Evening";
    else greeting = "Good Night";

    const el = document.getElementById("js-greeting");
    if (el) el.textContent = greeting;
  }

  document.addEventListener("astro:page-load", () => {
    updateGreeting();
    const lw = document.querySelector("live-window");
    if (lw) lw.addEventListener("live-window:clock-update", updateGreeting);
  });
</script>

<style>
  @reference "../layouts/BaseLayout/BaseLayout.css";

  /* Web component custom properties */
  live-window {
    --window-color: var(--color-midnight);
    --blinds-color: var(--color-midnight);
    --clock-text-color: #e74c3c;
    --weather-text-font: "Space Grotesk", sans-serif;
    --weather-text-color: var(--color-teal);
    --weather-text-margin: 12px 0;
    --weather-text-size: 14px;
    --weather-text-transform: uppercase;
    --weather-text-letter-spacing: 0.08em;
  }

  /* Timeline: horizontal scroll fade */
  .home-timeline {
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
  }

  /* Timeline: track line pseudo-element */
  .home-timeline__track::before {
    content: "";
    @apply absolute left-0 right-0 border-t border-border;
    top: 40px;
  }

  /* Timeline: current version glow */
  .home-timeline__item--current .home-timeline__thumb {
    @apply border-neon;
    box-shadow: 0 0 8px rgba(57, 255, 20, 0.3);
  }

  /* Timeline: name font size */
  .home-timeline__name {
    font-size: 0.6rem;
  }
</style>
