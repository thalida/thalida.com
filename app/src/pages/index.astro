---
import Chat from "../components/Chat.astro";
import ProjectTree from "../components/ProjectTree.astro";
import ContentViewer from "../components/ContentViewer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>thalida</title>
    <style is:global>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f0f0f0;
      }
      #layout {
        display: flex;
        height: 100vh;
        width: 100vw;
      }
      #project-tree,
      #content-viewer,
      #chat-panel {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1em;
        border-right: 1px solid #ccc;
      }
      #project-tree {
        flex: 0 0 25%;
      }
      #content-viewer {
        flex: 1 1 50%;
      }
      #chat-panel {
        flex: 0 0 25%;
        border-right: none;
      }
    </style>
  </head>
  <body>
    <div id="layout">
      <ProjectTree />
      <ContentViewer />
      <Chat />
    </div>
  </body>
</html>
