---
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";

const openweatherKey = import.meta.env.PUBLIC_OPENWEATHER_KEY || "";
const ipregistryKey = import.meta.env.PUBLIC_IPREGISTRY_KEY || "";
---

<BaseLayout activePage="">
  <live-window openweather-key={openweatherKey} ipregistry-key={ipregistryKey} theme="dark"></live-window>
  <div class="home-hero">
    <h1 class="home-hero__title">Work &amp; Play</h1>
    <p class="home-hero__subtitle">A creative's catalog</p>
    <p class="home-hero__body">Designer, developer, maker of things. Browse my projects, guides, gallery, and more.</p>
    <div class="home-hero__tags">
      <a href="/projects" class="home-hero__tag">Projects</a>
      <a href="/guides" class="home-hero__tag">Guides</a>
      <a href="/gallery" class="home-hero__tag">Gallery</a>
    </div>
  </div>
</BaseLayout>

<script src="../scripts/live-window/live-window.ts"></script>

<style>
  @reference "../layouts/BaseLayout/BaseLayout.css";

  .home-hero {
    @apply mt-8;
  }

  .home-hero__title {
    @apply m-0 font-display font-bold text-neon text-[clamp(2.5rem,6vw,4.8rem)] tracking-[-0.035em] leading-none;
  }

  .home-hero__subtitle {
    @apply m-0 mt-3 font-heading text-teal text-[clamp(1rem,2vw,1.4rem)] tracking-[-0.01em];
  }

  .home-hero__body {
    @apply m-0 mt-4 font-body text-muted leading-relaxed max-w-lg text-[0.9rem];
  }

  .home-hero__tags {
    @apply flex flex-wrap gap-2 mt-6;
  }

  .home-hero__tag {
    @apply bg-transparent border border-teal text-teal no-underline capitalize font-body transition-colors text-[0.7rem] rounded py-1 px-2.5 tracking-[0.06em];
  }

  .home-hero__tag:hover {
    @apply bg-teal/10 text-teal;
  }
</style>
