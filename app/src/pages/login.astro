---
const wsUrl = import.meta.env.PUBLIC_CHAT_WS_URL || "ws://localhost:8787/ws";
const LS_ADMIN_TOKEN_KEY = "admin_token";
const apiBase = wsUrl.replace(/^ws(s?):/, "http$1:").replace(/\/ws$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>login &middot; thalida</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=IBM+Plex+Mono:wght@400&family=Space+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="login-card">
      <h1>Login</h1>
      <form id="js-admin-form">
        <input
          id="js-admin-secret"
          type="password"
          placeholder="Enter password..."
          autocomplete="current-password"
          required
        />
        <button type="submit">Log in</button>
        <p id="js-admin-error" hidden></p>
      </form>
      <p class="back-link"><a href="/">&larr; back to chat</a></p>
    </div>

    <script is:inline define:vars={{ apiBase, LS_ADMIN_TOKEN_KEY }}>
      const form = document.getElementById("js-admin-form");
      const input = document.getElementById("js-admin-secret");
      const errorEl = document.getElementById("js-admin-error");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const secret = input.value.trim();
        if (!secret) return;

        errorEl.hidden = true;
        form.querySelector("button").disabled = true;

        try {
          const resp = await fetch(`${apiBase}/auth`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token: secret }),
          });
          if (!resp.ok) {
            errorEl.textContent = "Invalid password.";
            errorEl.hidden = false;
            return;
          }
        } catch {
          errorEl.textContent = "Could not reach the API. Is the server running?";
          errorEl.hidden = false;
          return;
        } finally {
          form.querySelector("button").disabled = false;
        }

        localStorage.setItem(LS_ADMIN_TOKEN_KEY, secret);
        window.location.href = "/";
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-midnight: #030a12;
    --color-surface: #0d1f2d;
    --color-neon: #39ff14;
    --color-teal: #00e5a0;
    --color-text: #e8f0f8;
    --color-border: #152535;
    --color-error: #ff4444;
  }

  body {
    margin: 0;
    background: var(--color-midnight);
    color: var(--color-text);
    font-family: "IBM Plex Mono", monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
  }

  .login-card {
    max-width: 360px;
    width: 100%;
    padding: 2rem;
  }

  h1 {
    font-family: "Bricolage Grotesque", sans-serif;
    color: var(--color-neon);
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  input {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9rem;
  }

  button {
    padding: 0.6rem 1.25rem;
    border: none;
    border-radius: 6px;
    background: var(--color-teal);
    color: var(--color-midnight);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
  }

  #js-admin-error {
    color: var(--color-error);
    font-size: 0.85rem;
    margin: 0;
  }

  .back-link {
    margin-top: 1.5rem;
  }

  .back-link a {
    color: var(--color-teal);
    font-size: 0.85rem;
  }
</style>
