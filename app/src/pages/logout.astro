---
const LS_ADMIN_TOKEN_KEY = "admin_token";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>logging out&hellip; &middot; thalida</title>
  </head>
  <body
    style="margin:0;background:#030A12;color:#E8F0F8;font-family:'IBM Plex Mono',monospace;display:flex;align-items:center;justify-content:center;min-height:100vh;"
  >
    <p>Logging out&hellip;</p>

    <script is:inline define:vars={{ LS_ADMIN_TOKEN_KEY }}>
      localStorage.removeItem(LS_ADMIN_TOKEN_KEY);
      window.location.href = "/";
    </script>

    <noscript>
      <p>JavaScript is required to log out. <a href="/">Go back</a>.</p>
    </noscript>
  </body>
</html>
