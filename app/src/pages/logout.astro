---
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import { SS_SESSION_TOKEN_KEY } from "@lib/constants";
---

<BaseLayout title="logging out… · thalida" noindex>
  <div class="flex items-center justify-center min-h-full">
    <p class="font-body text-text text-sm">Logging out&hellip;</p>
  </div>

  <script is:inline define:vars={{ SS_SESSION_TOKEN_KEY }}>
    sessionStorage.removeItem(SS_SESSION_TOKEN_KEY);
    window.location.href = "/";
  </script>

  <noscript>
    <p class="font-body text-text text-sm">
      JavaScript is required to log out. <a href="/" class="text-teal">Go back</a>.
    </p>
  </noscript>
</BaseLayout>
