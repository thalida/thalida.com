---
export const partial = true;

import { getCollection } from "astro:content";

const entries = await getCollection("links", ({ data }) => !data.draft);

const grouped = new Map<string, typeof entries>();
for (const entry of entries) {
  const cat = entry.data.category ?? "other";
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(entry);
}

for (const items of grouped.values()) {
  items.sort((a, b) => Number(b.data.publishedOn) - Number(a.data.publishedOn));
}

function formatCategory(slug: string): string {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" & ");
}

function formatHostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}

function faviconUrl(siteUrl: string): string {
  try {
    const origin = new URL(siteUrl).origin;
    return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(origin)}&sz=64`;
  } catch {
    return "";
  }
}
---

<article>
  <h2>Links</h2>
  <p><em>Curated resources, tools, and websites.</em></p>
  <hr />

  {
    [...grouped.entries()].map(([category, items]) => (
      <details class="link-group" open>
        <summary>
          {formatCategory(category)} ({items.length})
        </summary>
        <div class="link-grid">
          {items.map((item) => (
            <a href={item.id} target="_blank" rel="noopener" class="link-card">
              <img class="link-card__icon" src={faviconUrl(item.id)} alt="" loading="lazy" width="32" height="32" />
              <div class="link-card__body">
                <span class="link-card__title">{item.data.title}</span>
                <span class="link-card__url">{formatHostname(item.id)}</span>
                {item.data.tags && item.data.tags.length > 0 && (
                  <div class="link-card__tags">
                    {item.data.tags.map((tag: string) => (
                      <span class="link-card__tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </details>
    ))
  }
</article>

<style is:inline>
  .link-group {
    margin-bottom: 0.75em;
  }

  .link-group summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1em;
    color: #444;
    padding: 0.5em 0;
    user-select: none;
    list-style: disclosure-closed;
  }

  .link-group[open] summary {
    list-style: disclosure-open;
    margin-bottom: 0.4em;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75em;
  }

  .link-card {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 0.75em;
    padding: 0.75em 0.85em;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e0e0e0;
    text-decoration: none;
    color: #333;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      background 0.15s;
  }

  .link-card:hover {
    border-color: #a5b4fc;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    background: #fafbff;
  }

  .link-card__icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    flex-shrink: 0;
    background: #f5f5f5;
    margin-top: 0.15em;
  }

  .link-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    min-width: 0;
  }

  .link-card__title {
    font-weight: 600;
    font-size: 0.88em;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .link-card__url {
    font-size: 0.75em;
    color: #999;
  }

  .link-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
    margin-top: 0.15em;
  }

  .link-card__tag {
    font-size: 0.65em;
    padding: 0.15em 0.5em;
    border-radius: 4px;
    background: #f0f0f0;
    color: #666;
  }
</style>
