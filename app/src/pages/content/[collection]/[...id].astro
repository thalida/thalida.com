---
export const partial = true;

import { getCollection, render } from "astro:content";
import { COLLECTION_NAMES } from "../../../content.config";

export async function getStaticPaths() {
  const paths: Array<{
    params: { collection: string; id: string };
    props: { entry: any };
  }> = [];

  for (const name of COLLECTION_NAMES) {
    if (name === "links") continue;

    const entries = await getCollection(name, ({ data }) => !data.draft);
    for (const entry of entries) {
      paths.push({
        params: { collection: name, id: entry.id },
        props: { entry },
      });
    }
  }

  return paths;
}

const { entry } = Astro.props;

let Content: any = null;
try {
  const rendered = await render(entry);
  Content = rendered.Content;
} catch {
  // Content could not be rendered
}
---

<article>
  <h2>{entry.data.title}</h2>
  {entry.data.description && <p><em>{entry.data.description}</em></p>}
  <hr />
  {Content ? <Content /> : <p>Content could not be rendered.</p>}
</article>
