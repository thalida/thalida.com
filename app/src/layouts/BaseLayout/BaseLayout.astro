---
import { ClientRouter } from "astro:transitions";
import Chat from "@components/Chat/Chat.astro";
import ProjectTree from "@components/ProjectTree/ProjectTree.astro";
import CommandPalette from "@components/CommandPalette/CommandPalette.astro";
import { NAV_ORDER, getNavData } from "@lib/nav-data";
import "./BaseLayout.css";

interface Props {
  title?: string;
  activePage?: string;
  activeCollection?: string;
  pageContext?: {
    collection: string;
    id: string;
    title: string;
  } | null;
}

const { title = "thalida", activePage, activeCollection, pageContext = null } = Astro.props;
const navData = await getNavData();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    {pageContext && <meta name="page-context" content={JSON.stringify(pageContext)} />}
  </head>
  <body>
    <div id="mobile-toolbar">
      <a href="/" id="mobile-title">thalida</a>
      <nav id="tablet-nav" class="hidden md:flex lg:hidden" aria-label="Navigation">
        {
          NAV_ORDER.map((entry) =>
            entry.type === "page" ? (
              <a
                href={`/${entry.page}`}
                class="tablet-nav-link"
                data-active={activePage === entry.page ? "true" : undefined}
              >
                {entry.label}
              </a>
            ) : navData[entry.collection] ? (
              <a
                href={`/${entry.collection}`}
                class="tablet-nav-link"
                data-active={activeCollection === entry.collection ? "true" : undefined}
              >
                {navData[entry.collection].title}
              </a>
            ) : null,
          )
        }
        <button id="tablet-search-btn" type="button" aria-label="Search">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </nav>
      <div id="mobile-toolbar-right" class="flex items-center gap-2 md:hidden">
        <a href="/about" id="mobile-about-link">about</a>
        <button id="mobile-menu-btn" type="button" aria-label="Open navigation">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <div id="nav-backdrop" class="md:hidden"></div>
    <div id="chat-overlay-backdrop" class="md:hidden"></div>
    <div id="nav-panel" class="md:hidden">
      <ProjectTree activePage={activePage} activeCollection={activeCollection} />
    </div>
    <div id="layout">
      <ProjectTree activePage={activePage} activeCollection={activeCollection} />
      <div id="content-viewer">
        <slot />
      </div>
      <Chat />
    </div>
    <button id="mobile-chat-fab" type="button" aria-label="Open chat">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </button>
    <div id="chat-overlay" class="md:hidden">
      <button id="chat-overlay-close" type="button" aria-label="Close chat">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div id="chat-overlay-content"></div>
    </div>
    <CommandPalette />
    <script src="./BaseLayout.ts"></script>
  </body>
</html>
