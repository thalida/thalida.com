---
import { ClientRouter } from "astro:transitions";
import Chat from "@components/Chat/Chat.astro";
import ProjectTree from "@components/ProjectTree/ProjectTree.astro";
import CommandPalette from "@components/CommandPalette/CommandPalette.astro";
import "./BaseLayout.css";

interface Props {
  title?: string;
  activePage?: string;
  activeCollection?: string;
  pageContext?: {
    collection: string;
    id: string;
    title: string;
  } | null;
}

const { title = "thalida", activePage, activeCollection, pageContext = null } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    {pageContext && <meta name="page-context" content={JSON.stringify(pageContext)} />}
  </head>
  <body>
    <div id="mobile-toolbar">
      <button id="mobile-menu-btn" type="button" aria-label="Open projects">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <span id="mobile-title">thalida</span>
      <div id="mobile-toolbar-right">
        <button id="mobile-search-btn" type="button" aria-label="Search">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <button id="mobile-chat-btn" type="button" aria-label="Open chat">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      </div>
    </div>
    <div id="drawer-backdrop"></div>
    <div id="layout">
      <ProjectTree activePage={activePage} activeCollection={activeCollection} />
      <div id="content-viewer">
        <slot />
      </div>
      <Chat />
    </div>
    <CommandPalette />
    <script src="./BaseLayout.ts"></script>
  </body>
</html>
