---
import { categoryDisplay } from "@lib/format-utils";

interface Props {
  collection: string;
  categories: string[];
  activeCategory?: string;
}

const { collection, categories, activeCategory } = Astro.props;
---

{
  categories.length > 0 && (
    <div class="mb-6">
      <div class="flex flex-wrap gap-2">
        <a
          href={`/${collection}`}
          class:list={[
            "border font-body transition-colors no-underline capitalize text-xs rounded-sm py-1 px-3 tracking-wide",
            !activeCategory
              ? "bg-white/15 text-white! border-white"
              : "bg-transparent border-teal text-teal hover:bg-teal/20 hover:text-white hover:border-white/60",
          ]}
        >
          All
        </a>
        {categories.map((cat) => (
          <a
            href={`/${collection}/${encodeURIComponent(cat)}`}
            class:list={[
              "border font-body transition-colors no-underline capitalize text-xs rounded-sm py-1 px-3 tracking-wide",
              cat === "dead-links"
                ? activeCategory === cat
                  ? "bg-white/15 text-white! border-white"
                  : "bg-error/15 border-error text-error hover:bg-error/30 hover:text-white hover:border-white/60"
                : activeCategory === cat
                  ? "bg-white/15 text-white! border-white"
                  : "bg-transparent border-teal text-teal hover:bg-teal/20 hover:text-white hover:border-white/60",
            ]}
          >
            {categoryDisplay(cat)}
          </a>
        ))}
      </div>
    </div>
  )
}
