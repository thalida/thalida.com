---
const wsUrl = import.meta.env.PUBLIC_CHAT_WS_URL || "ws://localhost:8787/ws";
---

<aside
  id="chat-panel"
  class="hidden lg:flex lg:flex-col lg:border-l lg:border-border lg:p-4 font-body gap-1 overflow-y-auto overflow-x-hidden lg:shrink-0 lg:grow-0 lg:w-80 lg:min-w-80"
  transition:persist="chat"
>
  <div id="chat-header" class="flex flex-col gap-0.5 m-0">
    <div id="chat-header-top" class="flex items-center gap-1.5">
      <h2 class="m-0 font-heading text-base font-semibold text-teal tracking-tight">Chat</h2>
      <span id="chat-status-dot" class="inline-block shrink-0 w-2 h-2 rounded-full bg-muted data-[online=true]:bg-neon"
      ></span>
      <span id="chat-owner-status" class="flex-1 text-xs text-muted data-[online=true]:text-neon">offline</span>
      <span id="chat-user-count" class="text-xs text-muted" title="0 viewers"
        ><i class="fa-solid fa-eye"></i> 0 viewers</span
      >
      <button id="chat-overlay-close" class="hidden" type="button" aria-label="Close chat">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div id="chat-username-bar" class="flex items-center gap-1.5">
      <label for="chat-username" class="whitespace-nowrap uppercase tracking-widest font-body text-2xs text-muted"
        >chatting as</label
      >
      <input
        id="chat-username"
        class="flex-1 py-0.5 px-1 text-xs font-body bg-transparent text-text min-w-0 focus:outline-none"
        type="text"
        autocomplete="off"
        minlength="2"
        maxlength="20"
        pattern="[a-z0-9_.-]+"
        title="2-20 characters: lowercase letters, numbers, hyphens, underscores, dots. No spaces."
      />
    </div>
  </div>

  <div id="chat-room" class="flex flex-col gap-2 flex-1 min-h-0">
    <div id="chat-messages" class="flex-1 text-sm text-text overflow-y-auto min-h-0"></div>
    <span id="chat-context" hidden>
      about
      <select id="chat-context-select">
        <option value="page"></option>
        <option value="general">general</option>
      </select>
    </span>
    <div id="chat-input-bar" class="flex items-center gap-1">
      <input
        id="chat-input"
        class="flex-1 py-2 px-3 border border-border rounded-md text-sm font-body bg-midnight text-text min-w-0 focus:outline-none focus:border-teal"
        type="text"
        placeholder="Type a message..."
        autocomplete="off"
      />
      <button
        id="chat-send"
        class="p-2 border-none bg-transparent text-muted text-sm hover:text-neon transition-colors"
        type="button"><i class="fa-solid fa-paper-plane"></i></button
      >
    </div>
  </div>
</aside>

<meta name="chat-ws-url" content={wsUrl} />

<script src="./chat-client.ts"></script>

<style>
  #chat-username {
    border: none;
    border-bottom: 1px dashed var(--color-border);
    border-radius: 0;
    box-shadow: none;
  }
  #chat-username:focus {
    border-bottom-color: var(--color-teal);
  }
</style>
