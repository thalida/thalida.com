---
const wsUrl = import.meta.env.PUBLIC_CHAT_WS_URL || "ws://localhost:8787/ws";
---

<aside id="chat-panel">
  <h2>Chat</h2>
  <div>
    <span id="chat-connection-status">offline</span>
    &middot;
    <span id="chat-owner-status">thalida: offline</span>
    &middot;
    <span id="chat-user-count">0 users connected</span>
  </div>
  <hr />

  <div id="chat-username-bar">
    <label for="chat-username">chatting as:</label>
    <input
      id="chat-username"
      type="text"
      autocomplete="off"
      minlength="2"
      maxlength="20"
      pattern="[a-z0-9_\-.]+"
      title="2-20 characters: lowercase letters, numbers, hyphens, underscores, dots. No spaces."
    />
    <button id="chat-rename-btn" type="button">save</button>
  </div>

  <div id="chat-room">
    <div id="chat-messages" style="min-height:200px;max-height:60vh;overflow-y:auto;"></div>
    <div>
      <input id="chat-input" type="text" placeholder="Type a message..." autocomplete="off" />
      <button id="chat-send" type="button">Send</button>
    </div>
  </div>
</aside>

<meta name="chat-ws-url" content={wsUrl} />

<script src="../scripts/chat-client.ts"></script>
