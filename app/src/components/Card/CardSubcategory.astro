---
import { prettifySlug } from "@lib/format-utils";

interface Props {
  subcategory?: string;
}

const { subcategory } = Astro.props;
---

{
  subcategory && (
    <p class="m-0 font-body uppercase text-muted text-2xs tracking-widest">
      <span class="text-dim">/</span> {prettifySlug(subcategory)}
    </p>
  )
}
