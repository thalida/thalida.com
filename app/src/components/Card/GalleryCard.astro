---
import type { NavItem } from "@lib/nav-data";
import { formatDate } from "@lib/nav-data";
import CardCategory from "./CardCategory.astro";
import CardCover from "./CardCover.astro";
import CardTags from "./CardTags.astro";

interface Props {
  item: NavItem;
}

const { item } = Astro.props;

const href = `/${item.collection}/${item.id}`;
---

<a href={href} class="group item-card overflow-hidden flex flex-col max-h-80">
  <div class="overflow-hidden flex-1">
    <CardCover
      src={item.coverImageSrc}
      alt={item.coverImageAlt ?? item.title}
      title={item.title}
      imgClass="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      placeholderClass="w-full h-full aspect-4/3"
    />
  </div>
  <div class="p-3 flex flex-col gap-0.5">
    <div class="flex items-center gap-2">
      <CardCategory category={item.category} />
      <span class="text-muted/40 text-2xs">{formatDate(item.publishedOn)}</span>
    </div>
    <h3 class="m-0 font-heading font-bold text-text text-sm leading-snug">{item.title}</h3>
    <CardTags tags={item.tags} />
  </div>
</a>
