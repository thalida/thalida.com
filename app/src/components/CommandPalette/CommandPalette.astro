---
import { getNavData } from "@lib/nav-data";

const navData = await getNavData();

const allItems = Object.values(navData).flatMap((col) =>
  col.items.map((item) => ({
    ...item,
    collectionTitle: col.title,
  })),
);

const collections = Object.entries(navData).map(([key, col]) => ({
  key,
  title: col.title,
}));
---

<div id="command-palette" class="hidden fixed inset-0 z-1000 overflow-hidden" aria-hidden="true">
  <div id="js-cp-backdrop" class="absolute inset-0 bg-midnight/70 backdrop-blur-sm"></div>
  <div
    id="js-cp-dialog"
    class="relative w-full bg-surface overflow-hidden font-body flex flex-col shadow-dialog"
    role="dialog"
    aria-label="Search content"
  >
    <div class="flex items-center gap-2 py-3 px-4 border-b border-border">
      <select
        id="js-cp-collection-select"
        class="py-2 px-3 border border-border rounded-md text-xs font-body bg-midnight text-text outline-none min-w-24 hover:border-muted/50 focus:border-teal focus:ring-2 focus:ring-teal/20"
      >
        <option value="">All</option>
        {collections.map((col) => <option value={col.key}>{col.title}</option>)}
      </select>
      <input
        type="text"
        id="js-cp-input"
        class="cp-input flex-1 border-none outline-none text-sm py-0.5 font-body bg-transparent text-text"
        placeholder="Search…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div class="overflow-y-auto flex-1 p-2" id="cp-results"></div>
    <div class="hidden md:flex gap-4 py-2 px-4 border-t border-border text-xs text-muted">
      <span class="flex items-center gap-1"
        ><kbd class="text-xs py-0.5 px-2 border border-border rounded-sm bg-midnight font-body text-muted"
          >&uarr;&darr;</kbd
        > navigate</span
      >
      <span class="flex items-center gap-1"
        ><kbd class="text-xs py-0.5 px-2 border border-border rounded-sm bg-midnight font-body text-muted">&crarr;</kbd> open</span
      >
      <span class="flex items-center gap-1"
        ><kbd class="text-xs py-0.5 px-2 border border-border rounded-sm bg-midnight font-body text-muted">esc</kbd> close</span
      >
    </div>
  </div>
</div>

<style>
  #command-palette.cp-overlay--open {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #js-cp-dialog {
    max-width: calc(100% - 2rem);
    border-radius: 0.5rem;
    max-height: calc(100svh - 6rem);
  }
  @media (min-width: 768px) {
    #js-cp-dialog {
      max-width: 32rem;
      max-height: 60%;
    }
  }
  .cp-input::placeholder {
    color: color-mix(in srgb, var(--color-muted) 60%, transparent);
  }
</style>
<style is:global>
  #cp-results .cp-row--selected {
    background-color: var(--color-surface-active);
    color: #ffffff;
  }
  #cp-results .cp-row--selected .cp-row__title {
    color: #ffffff;
  }
  #cp-results .cp-row__img--empty span {
    background: linear-gradient(135deg, var(--color-neon) 0%, var(--color-teal) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  #cp-results .cp-row__initial {
    background: linear-gradient(135deg, var(--color-neon) 0%, var(--color-teal) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<template id="cp-row-tpl">
  <a
    class="cp-row flex items-center justify-between gap-3 py-2 px-3 rounded-md no-underline text-muted transition-colors hover:bg-midnight hover:text-text"
  >
    <img data-cp="cover-img" hidden class="w-8 h-8 rounded object-cover shrink-0 bg-midnight" src="" alt="" />
    <div
      data-cp="cover-placeholder"
      hidden
      class="cp-row__img--empty w-8 h-8 rounded shrink-0 bg-midnight flex items-center justify-center text-xs font-semibold uppercase font-display border border-border"
    >
      <span data-cp="initial"></span>
    </div>
    <div class="flex-1 min-w-0 flex flex-col gap-0.5">
      <div data-cp="meta" hidden>
        <span class="text-2xs text-neon uppercase tracking-widest">
          <span data-cp="collection"></span><span data-cp="meta-sep" hidden class="text-dim"> / </span><span
            data-cp="category"></span>
        </span>
      </div>
      <span data-cp="title" class="cp-row__title text-sm font-heading font-medium truncate text-text"></span>
    </div>
    <span data-cp="date" class="text-xs text-muted shrink-0"></span>
  </a>
</template>

<template id="cp-row-external-tpl">
  <a
    class="cp-row flex items-center gap-3 py-2 px-3 rounded-md no-underline text-muted transition-colors hover:bg-midnight hover:text-text"
    target="_blank"
    rel="noopener"
  >
    <div class="w-8 h-8 rounded shrink-0 bg-midnight flex items-center justify-center border border-border">
      <img data-cp="favicon-img" hidden class="w-4 h-4 rounded-sm shrink-0" src="" alt="" />
      <div
        data-cp="favicon-placeholder"
        hidden
        class="w-4 h-4 rounded-sm shrink-0 bg-midnight flex items-center justify-center text-2xs font-semibold uppercase font-display border border-border"
      >
        <span data-cp="initial" class="cp-row__initial"></span>
      </div>
    </div>
    <div class="flex-1 min-w-0 flex flex-col gap-0.5">
      <div data-cp="meta" hidden>
        <span class="text-2xs text-neon uppercase tracking-widest">
          <span data-cp="collection"></span><span data-cp="meta-sep" hidden class="text-dim"> / </span><span
            data-cp="category"></span>
        </span>
      </div>
      <span data-cp="title" class="cp-row__title text-sm font-heading font-medium truncate text-text"></span>
      <span class="cp-row__domain text-2xs text-muted flex items-center gap-1">
        <span data-cp="domain"></span>
        <i class="fa-solid fa-arrow-up-right-from-square text-muted opacity-60 text-[10px]" aria-hidden="true"></i>
      </span>
    </div>
  </a>
</template>

<template id="cp-empty-tpl">
  <div class="py-8 px-4 text-center text-muted text-sm">No results found</div>
</template>

<script define:vars={{ allItems, navData }}>
  window.__cpData = { allItems, navData };
</script>

<script src="./CommandPalette.ts"></script>
