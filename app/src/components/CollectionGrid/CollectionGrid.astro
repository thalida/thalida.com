---
import { type NavItem } from "@lib/nav-data";
import Card from "@components/Card/Card.astro";
import type { CardVariant } from "@components/Card/Card.astro";
import CategoryFilter from "@components/CategoryFilter/CategoryFilter.astro";

interface Props {
  collection: string;
  title: string;
  subtitle: string;
  itemCount: number;
  items: NavItem[];
  allCategories: string[];
  activeCategory?: string;
}

const { collection, title, subtitle, itemCount, items, allCategories, activeCategory } = Astro.props;

const LINK_COLLECTIONS = new Set(["links"]);
const FLAG_COLLECTIONS = new Set(["recipes"]);
const GALLERY_COLLECTIONS = new Set(["gallery"]);

let variant: CardVariant = "stacked";
if (LINK_COLLECTIONS.has(collection)) variant = "link";
else if (FLAG_COLLECTIONS.has(collection)) variant = "flag";
else if (GALLERY_COLLECTIONS.has(collection)) variant = "gallery";

const useGallery = GALLERY_COLLECTIONS.has(collection);
---

<div class="font-body max-w-5xl mx-auto">
  <header class="mb-6">
    <h1 class="page-title mb-3">{title}</h1>
    <p class="m-0 mb-3 font-heading font-semibold text-text text-subtitle tracking-tight">{subtitle}</p>
    <p class="m-0 font-body text-muted text-sm">{itemCount} items</p>
  </header>

  <CategoryFilter collection={collection} categories={allCategories} activeCategory={activeCategory} />

  <div
    class:list={[
      "items-grid grid gap-4 grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3",
      { "grid-cols-2 gap-4": useGallery },
    ]}
  >
    {items.map((item) => <Card variant={variant} item={item} />)}
  </div>
</div>

<script>
  const ROW_PX = 10;

  function layoutMasonry() {
    const grid = document.querySelector(".items-grid") as HTMLElement | null;
    if (!grid) return;

    // On single-column (mobile), disable masonry
    const cols = getComputedStyle(grid).gridTemplateColumns.split(" ").length;
    if (cols <= 1) {
      grid.classList.remove("masonry-ready");
      for (const card of grid.children) {
        (card as HTMLElement).style.gridRowEnd = "";
      }
      return;
    }

    // Step 1: Reset to natural layout for measurement
    grid.classList.remove("masonry-ready");
    grid.style.alignItems = "start";
    for (const card of grid.children) {
      (card as HTMLElement).style.gridRowEnd = "";
    }

    // Force reflow so cards shrink to natural content height
    void grid.offsetHeight;

    // Step 2: Measure natural heights, compute spans
    const spans: number[] = [];
    for (const card of grid.children) {
      const height = (card as HTMLElement).getBoundingClientRect().height;
      // +1 row for the margin-bottom gap
      spans.push(Math.ceil(height / ROW_PX) + 1);
    }

    // Step 3: Apply masonry mode and spans
    grid.style.alignItems = "";
    grid.classList.add("masonry-ready");
    Array.from(grid.children).forEach((card, i) => {
      (card as HTMLElement).style.gridRowEnd = `span ${spans[i]}`;
    });
  }

  function initMasonry() {
    layoutMasonry();

    // Re-layout after images load
    document.querySelectorAll(".items-grid img").forEach((img) => {
      if (!(img as HTMLImageElement).complete) {
        img.addEventListener("load", layoutMasonry, { once: true });
      }
    });
  }

  // Run on every page navigation (View Transitions)
  document.addEventListener("astro:page-load", initMasonry);

  // Re-layout on resize
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(layoutMasonry, 100);
  });
</script>

<style>
  .items-grid.masonry-ready {
    gap: 0 1rem;
    grid-auto-rows: 10px;
  }
  .items-grid.masonry-ready > :global(.item-card) {
    margin-bottom: 1rem;
  }
</style>
