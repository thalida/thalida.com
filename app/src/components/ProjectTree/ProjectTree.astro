---
import { NAV_ORDER, getNavData } from "@lib/nav-data";
import SpotifyPlayer from "@components/SpotifyPlayer/SpotifyPlayer.astro";

interface Props {
  activePage?: string;
  activeCollection?: string;
}

const { activePage, activeCollection } = Astro.props;
const navData = await getNavData();
---

<nav id="site-nav" aria-label="Main navigation" data-active-collection={activeCollection || ""}>
  <h2><a href="/" class="nav-heading-link">thalida</a></h2>

  <button class="nav-search-trigger" type="button" id="nav-search-btn">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>Search…</span>
    <kbd class="nav-search-shortcut">⌘K</kbd>
  </button>

  <div class="nav-container">
    <ul class="nav-list">
      {
        NAV_ORDER.map((entry) =>
          entry.type === "page" ? (
            <li>
              <a
                href={`/${entry.page}`}
                class="nav-row nav-row--page"
                data-active={activePage === entry.page ? "true" : undefined}
              >
                <span class="nav-dot" />
                {entry.label}
              </a>
            </li>
          ) : navData[entry.collection] ? (
            <li>
              <a
                href={`/${entry.collection}`}
                class="nav-row nav-row--collection"
                data-active={activeCollection === entry.collection ? "true" : undefined}
              >
                <span class="nav-dot" />
                <span class="nav-row__label">{navData[entry.collection].title}</span>
                <span class="nav-row__count">{navData[entry.collection].items.length}</span>
              </a>
            </li>
          ) : null,
        )
      }
    </ul>
  </div>

  <SpotifyPlayer />
</nav>

<script src="./ProjectTree.ts"></script>

<style>
  /* force HMR recompile */
  @import "./ProjectTree.css";
</style>
