# Copy to .env and adjust as needed.
# PUBLIC_ prefix is required for Astro to expose vars to the client.

# WebSocket URL for the chat API.
# Local dev:      ws://localhost:8787/ws
# Tunnel:         wss://your-tunnel-url.trycloudflare.com/ws
# Production:     wss://your-api.workers.dev/ws
PUBLIC_CHAT_WS_URL=ws://localhost:8787/ws

# Base URL for media files hosted on Cloudflare R2.
# Leave empty for local dev (images served locally with Astro optimization).
# Set to R2 public URL for production/preview (e.g. https://pub-xxxx.r2.dev).
# The branch prefix is auto-detected from CF_PAGES_BRANCH in Cloudflare Pages builds.
PUBLIC_R2_BASE_URL=
