{
  "name": "thalida-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --allowed-hosts=.thalida.com,.trycloudflare.com --host",
    "build": "astro build",
    "build:pages": "astro build && find dist/content -type f ! -name '*.html' -delete 2>/dev/null; find dist/content -type d -empty -delete 2>/dev/null; true",
    "preview": "astro preview --host --port 4322 --allowed-hosts=.thalida.com,.trycloudflare.com",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.10.1",
    "astro-expressive-code": "^0.41.6",
    "astro-pagefind": "^1.8.5",
    "he": "^1.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-wrap": "^1.1.0",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-toc": "^9.0.0",
    "tailwindcss": "^4.2.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^25.3.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "jsdom": "^28.1.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
